# Go
/bin/
*.test
*.out
coverage.*

# Release artifacts (`make chart-package`) and the vendored Vault subchart `helm dependency update`
# fetches into the chart. Both are derived - the chart is released from its source, not from these.
/dist/
deploy/helm/kaas/charts/
deploy/helm/kaas/Chart.lock

# Local env / secrets
.env
*.pem
*.key

# Real directory-auth config (deploy/ldap.example.yaml IS tracked and is what compose mounts by
# default; a real one names your DCs and service account, so keep it out of the repo).
deploy/ldap.yaml

# Terraform / OpenTofu state (per-cluster; treated as derived - ADR-004)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Packer
packer/build/
packer/output/
packer/output-*/
*.qcow2
*.img

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local tests
scripts/govc-list-ips.sh
examples/

# Static browser demo (`make demo-wasm`): the WebAssembly control plane and the Go runtime shim it
# needs. Both are build artifacts - the module is ~46 MB - regenerated by the Pages workflow.
web/portal/public/demo/

# Harbor (the image registry, `make harbor-up`): the real harbor.yml carries the admin password, and
# the extracted installer + its generated compose/config are derived from it.
deploy/harbor/harbor.yml
deploy/harbor/harbor/
deploy/harbor/ca.crt
deploy/harbor/.lock
