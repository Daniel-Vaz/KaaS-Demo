# Copy to .env and adjust. Consumed by the app AND auto-loaded by `podman compose`
# (i.e. by `make up`).
#
# IMPORTANT for compose: values here must be LITERAL. Compose does not run `$(...)` command
# substitution and does not expand `~`. So use an absolute key path and paste the public key
# contents directly - e.g.
#   KAAS_SSH_PRIVATE_KEY_FILE=/home/you/.ssh/kaas
#   KAAS_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... kaas
# (For plain `source .env` in a shell before `go run`, `$(...)`/`~` are fine - but not for compose.)

# --- Platform ---------------------------------------------------------------

# 32+ char secret; the AES secret key AND the session-cookie signing key are derived
# from this (sha256). Set a stable value so encrypted secrets and login sessions survive
# restarts. If unset, an ephemeral key is generated.
KAAS_SECRET_KEY=change-me-to-a-long-random-string

# HTTP listen address for the API.
KAAS_ADDR=:8080

# The KVM host's capacity ceiling (physical cap). Handed out to non-admin accounts as per-user
# quota ON KVM, under a conserved-pool invariant (sum of all non-admin accounts' KVM grants <=
# this). Quota is per-infrastructure - vSphere has its own ceiling below, and a grant on one
# backend can never be spent on the other. The admin holds no stored quota of its own on any
# backend - its budget on each is whatever's left unallocated there, computed live - so granting a
# tenant never requires shrinking the admin's number first.
KAAS_BUDGET_VCPU=8
KAAS_BUDGET_MEM_MB=16384
# The KVM host's STORAGE ceiling (GB) - the libvirt storage pool's share this platform may hand out.
# Metered like vCPU/memory because a node pool can override its workers' root disk and a node can
# carry extra disks, so it is a dimension a tenant spends directly and without bound.
KAAS_BUDGET_DISK_GB=500

# Disable per-user quota. When true, an admin no longer carves each backend's ceiling into per-user
# grants - EVERY account automatically draws its admission budget from the whole ceiling of the
# infrastructure it builds on. The pool becomes shared first-come-first-served; the aggregate cap is
# unchanged, so a backend still can't be physically oversubscribed. The Admin page then shows how
# much of each backend every account is consuming instead of a grant editor, and grants can't be set
# while it is on. Stored grants are left untouched and resume if you turn it back off. Default false.
KAAS_SHARED_QUOTA=false

# Let the create wizard DESELECT the add-ons that ship with the bundle. Default false: a cluster is
# always born with the whole batteries-included set (Cilium, Longhorn, MetalLB + Envoy Gateway,
# cert-manager, external-dns, external-secrets, kube-prometheus-stack, metrics-server,
# trivy-operator) and an add-on can only be removed once the cluster is Ready. Set it true when the
# host can't carry all of that - on a laptop-scale KVM host the bundle can outweigh a small
# cluster's own workers and installing it is what tips the cluster over. Nothing else changes: every
# wiring step already gates on its add-on being installed, and the Add-ons tab behaves the same.
KAAS_BUNDLE_ADDONS_OPTIONAL=false

# Seeded admin account (created on first startup). Set a real password for anything shared.
# Under KAAS_AUTH=ldap this is also the BREAK-GLASS account: the one login that still works when the
# domain controllers don't, and the account `make kubeconfig` and deploy/teardown-clusters.sh use.
# The directory can never claim this username, so pick one no real person has.
KAAS_ADMIN_USERNAME=admin
KAAS_ADMIN_PASSWORD=admin

# --- Authentication ---------------------------------------------------------
# How users authenticate:
#   local  local accounts with passwords, open self-registration (the default)
#   ldap   Active Directory / LDAP. Accounts are created on first login and their groups+roles come
#          from the mapping rules in the config file below. Self-registration is disabled; the
#          seeded admin above keeps working as break-glass.
KAAS_AUTH=local

# ORTHOGONAL to KAAS_AUTH, exactly like KAAS_PROVISIONER is to KAAS_INFRA_PROVIDERS: that says
# whether to use a directory, this says whether the directory is real.
#   real   talk to the domain controllers in the config file
#   fake   an in-memory directory synthesized FROM those same mapping rules - one user per rule
#          (ad-<group_key>-<role>, plus ad-everyone and ad-nobody; password "demo").
#
# `KAAS_AUTH=ldap KAAS_LDAP=fake make up-fake` runs the entire AD flow - group seeding, account
# provisioning, membership sync - with no domain controller, and validates your real mapping rules
# on the way. Prove the config there before pointing it at a live DC.
KAAS_LDAP=fake

# The mapping config, mounted into the api container. deploy/ldap.example.yaml is tracked and is
# what compose mounts by default (harmless: KAAS_AUTH=local never reads it). For a real directory,
# copy it to deploy/ldap.yaml (gitignored) and point this at it.
#   cp deploy/ldap.example.yaml deploy/ldap.yaml
KAAS_LDAP_CONFIG_HOST=./ldap.example.yaml

# The service account's password. Deliberately NOT in ldap.yaml - that file is config (mountable as
# a plain ConfigMap), this is a secret. Only the API ever gets it; the worker never authenticates a
# user, so it stays out of the container holding the libvirt socket and every tenant's secrets.
KAAS_LDAP_BIND_PASSWORD=example

# Login throttle. /auth/login is public and unauthenticated, and with a directory every failed login
# is a real bad-password bind against a real AD account - so without a counter in front of it,
# anyone who can reach the portal could spray a name list and lock out the whole domain.
#
# Two scopes, with deliberately DIFFERENT limits:
#   per-username  the load-bearing one - protects a given account, and holds even when an attacker
#                 rotates source addresses. Keep it under your AD lockout policy (typically 3–5) so
#                 the platform is never what locks an account.
#   per-IP        catches one host spraying MANY usernames. Must be far higher than the per-user
#                 limit: a whole office shares one NAT egress address, so at 3 a few unrelated typos
#                 by colleagues would lock the building out of the portal.
KAAS_LDAP_MAX_FAILURES=3
KAAS_LDAP_MAX_IP_FAILURES=30
KAAS_LDAP_THROTTLE_WINDOW=5m

# --- Infrastructure providers -----------------------------------------------
# Which infrastructures users may deploy clusters ON (comma-separated, in order - the first is the
# default). With more than one, the portal's create wizard gains an early "Infrastructure" step;
# with one, that step is omitted and the choice is implicit. A cluster records the provider it was
# created on, immutably.
#
# This is ORTHOGONAL to KAAS_PROVISIONER below: this says which infrastructures exist, that says
# whether they are real. With KAAS_PROVISIONER=fake every provider here maps to the same fake
# provisioner, so `make up-fake` demos the whole multi-provider flow with no KVM and no vCenter.
#
# kvm | vsphere | proxmox  (comma-separated)
KAAS_INFRA_PROVIDERS=kvm

# --- Provider selection -----------------------------------------------------
# Default (unset) = fake providers: everything runs, no VMs are created. Tests and
# no-KVM machines rely on this. Set both to the real values for the Milestone 0 slice.

# fake | tofu
KAAS_PROVISIONER=fake
# fake | ansible
KAAS_CONFIG=fake
# fake | helm  (helm installs the cluster's add-ons; needs the `helm` binary)
KAAS_ADDONS=fake

# Read-only telemetry seams (per-node usage + cluster health checks). These run worker-side against
# the real cluster API with kubectl, so `make up` sets them to kubectl on the worker for you. Left
# fake here - fake synthesizes plausible usage/all-healthy without touching a cluster.
# fake | kubectl
KAAS_METRICS=fake
# fake | kubectl
KAAS_HEALTH=fake

# Automatic control-plane certificate rotation. kubeadm-managed control-plane certs expire ~1 year
# after issuance; a Ready, idle cluster is otherwise never re-reconciled, so its certs would silently
# lapse. When on, the reconciler observes each Ready cluster's earliest cert expiry and, once it falls
# within the window below, renews them (PhaseRenewingCerts: `kubeadm certs renew all` + a static-pod
# restart on every control plane, then re-seals the stored admin kubeconfig). With KAAS_CONFIG=fake
# this stays dormant (the fake reports a ~1-year expiry). Off = no observation, no renewal.
# 1|true|on (default) / 0|false|off
# KAAS_CERT_RENEW=1
# How close to expiry rotation fires (Go duration; default 720h = 30 days).
# KAAS_CERT_RENEW_WINDOW=720h

# Base dir for per-cluster OpenTofu/Ansible workspaces (state, inventory, artifacts).
# KAAS_WORK_DIR=/var/lib/kaas/workspaces

# --- Real OpenTofu provisioner (KAAS_PROVISIONER=tofu) ----------------------

# Directory of per-(OS,k8s) golden images named <os>-k8s-<k8s>.qcow2 (see catalog.GoldenImageName;
# `make golden-images` writes them here). The provisioner resolves each node's base image from here,
# so a cluster boots the right version and bundle upgrades re-clone nodes onto the right image.
# KAAS_IMAGE_DIR=/var/lib/libvirt/images

# Fallback base/golden qcow2 for any node whose image isn't in KAAS_IMAGE_DIR (or when it's unset).
# A single image still works - the `common` role converges kube* to the bundle's version over apt
# (downgrading if the image was baked newer than the bundle pins).
# KAAS_BASE_IMAGE=/var/lib/libvirt/images/ubuntu-26.04-k8s-1.36.2.qcow2

# SSH public key injected into every VM via cloud-init (literal contents).
# KAAS_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... kaas

# Optional overrides (defaults shown):
# KAAS_TOFU_BIN=tofu
# KAAS_LIBVIRT_MODULE_DIR=infra/libvirt
# KAAS_LIBVIRT_URI=qemu:///system   # derived from KAAS_KVM_HOST below when that is set
# KAAS_LIBVIRT_POOL=default
# KAAS_LIBVIRT_NETWORK=default

# --- Remote KVM host (optional; unset = the local hypervisor, the default) ---
# Point the platform at a KVM/libvirt host on another machine. Setting KAAS_KVM_HOST rewires all
# four paths that otherwise assume "the VMs are on this box" (see internal/kvmhost, docs/networking.md):
#
#   * OpenTofu dials libvirtd at qemu+ssh://<user>@<host>/system instead of the local socket;
#   * Ansible reaches the VMs with an ssh ProxyCommand through the KVM host;
#   * the worker opens an ssh SOCKS tunnel to it and stamps `proxy-url` into the kubeconfig used by
#     helm/kubectl, so add-ons, metrics, health, Workloads, Monitoring, Security and the Terminal all
#     reach the cluster API through the hypervisor.
#
# The host needs: sshd, a libvirtd the SSH user may use (the `libvirt` group), a `default` storage
# pool (a bare host has none - see docs/networking.md), and routes to the per-cluster bridges (it has
# them: it creates them). Golden images still live on the WORKER (KAAS_IMAGE_DIR/KAAS_BASE_IMAGE are
# worker-local paths); the provisioner uploads each into the host's pool ONCE and later clusters
# clone it with no upload at all.
#
# KAAS_KVM_HOST=kvm.lan
# KAAS_KVM_SSH_USER=root
# KAAS_KVM_SSH_PORT=22
# KAAS_KVM_SSH_KEY_FILE=/home/you/.ssh/kaas-kvm   # the PLATFORM's key to the hypervisor - NOT the VM key
# KAAS_KVM_KNOWN_HOSTS_FILE=/home/you/.ssh/known_hosts  # unset = host keys are NOT verified (dev shortcut)
# KAAS_KVM_SOCKS_ADDR=127.0.0.1:1080              # where the worker binds the tunnel; the shell sandbox
#                                                 # shares it (both are host-networked)
#
# The FIRST apply for a cluster uploads its base image to the remote pool over this tunnel - a
# multi-GB transfer that can take much longer than the 15m default reconcile-phase budget on a slow
# link (measured on one dev link: ~1.2MB/s, i.e. ~50min for a 3.5G image). Raise this or the job is
# SIGKILLed and retried before the upload ever finishes, forever. Not remote-KVM-specific - also
# covers a slow `helm --wait` install - but remote KVM is the case that actually needs it raised.
# KAAS_RECONCILE_JOB_TIMEOUT=15m

# HA control plane: first address of the pool the platform hands out as the keepalived VIP
# fronting each HA cluster's API servers. Must be free on the libvirt network's subnet and
# above its DHCP range (default libvirt DHCP fills 192.168.122.2+ from the bottom).
# KAAS_HA_VIP_BASE=192.168.122.240

# --- vSphere provider (KAAS_INFRA_PROVIDERS includes vsphere) ---------------
#
# Placement + credentials. The WORKER needs all of these (it drives OpenTofu against vCenter); the
# API needs only the network shape and budget below - it does admission, not provisioning, so it is
# deliberately never given vCenter credentials. Note: OpenTofu reaches vCenter, and Ansible/kubectl
# reach the cluster VMs, DIRECTLY - the worker must have L3 routing to the vSphere network. This
# provider cannot be combined with KAAS_KVM_HOST (whose SSH/SOCKS rerouting is global); the app
# refuses to start if both are set.
#
# KAAS_VSPHERE_URL=https://vcenter.example.internal
# KAAS_VSPHERE_USERNAME=DOMAIN\user
# KAAS_VSPHERE_PASSWORD=...
# KAAS_VSPHERE_INSECURE=1                     # accept a self-signed vCenter certificate (lab)
# KAAS_VSPHERE_DATACENTER=MyDC
# KAAS_VSPHERE_CLUSTER=CLUSTER01                    # compute cluster
# KAAS_VSPHERE_DATASTORE=datastorefc10k_002  # etcd's WAL lives here - see the note below
#
# Pick this datastore for LATENCY, not capacity. Every control plane runs etcd, which fsyncs its
# write-ahead log on the critical path of every write and wants that to complete in single-digit
# milliseconds. Put it on nearline/7.2K spinning storage shared with a busy lab and a large cluster
# will take the whole control plane down with it: cloning and booting ~7 VMs at once saturated
# `datastorenl_002` here and stretched a single etcd fdatasync to over TWO MINUTES, which cost etcd
# quorum (30 leader changes), 500'd every API server, and cascaded into a failed CNI install.
# Prefer flash/10K+ FC (`datastorefc10k_002`).
# Everything the platform creates lives under this VM folder: the golden-image TEMPLATES
# (<os>-k8s-<version>, built by `make golden-image-vsphere`), and one subfolder per cluster
# ("<name>-<id>") holding that cluster's VMs.
# KAAS_VSPHERE_FOLDER=DVaz
# KAAS_VSPHERE_MODULE_DIR=infra/vsphere       # optional override

# Network. All vSphere clusters share ONE operator-owned portgroup (unlike KVM, where each cluster
# gets its own isolated bridge), so the network is deployment configuration rather than a per-cluster
# choice. Two addressing modes:
#
#   dhcp   - the portgroup's own DHCP server assigns node IPs; the platform reads them back via
#            open-vm-tools. Node MACs are pinned, so a re-created node reclaims its lease (which is
#            what keeps a rolling OS upgrade's certs/etcd valid). For an HA cluster the USER supplies
#            the control-plane VIP in the wizard - only they know what is free outside the DHCP pool.
#   static - the platform allocates node IPs and the HA VIP from KAAS_VSPHERE_NET_RANGE and injects
#            them via cloud-init. Requires GATEWAY, DNS and RANGE below.
#
# KAAS_VSPHERE_NETWORK=serviceVMNetwork
# KAAS_VSPHERE_NET_MODE=dhcp                  # dhcp | static
# KAAS_VSPHERE_NET_CIDR=172.23.252.0/24       # the portgroup's subnet
# Static mode only:
# KAAS_VSPHERE_NET_GATEWAY=172.23.252.1
# KAAS_VSPHERE_NET_DNS=172.23.252.10,172.23.252.11
# KAAS_VSPHERE_NET_RANGE=172.23.252.200-172.23.252.239   # inclusive; must be free and outside DHCP

# The vSphere capacity ceiling - the counterpart of KAAS_BUDGET_* above, for this backend. Tenant
# quota on vSphere is granted out of it under the same conserved-pool invariant, and is separate
# from (and not interchangeable with) their KVM grant: a tenant needs vSphere quota to create a
# vSphere cluster, however much room they have on the KVM host.
# KAAS_VSPHERE_BUDGET_VCPU=64
# KAAS_VSPHERE_BUDGET_MEM_MB=131072
# KAAS_VSPHERE_BUDGET_DISK_GB=4096

# --- Proxmox VE provider (KAAS_INFRA_PROVIDERS includes proxmox) ------------
#
# Architecturally the same as vSphere: VMs clone a golden TEMPLATE onto the operator's shared
# network (a bridge), with dhcp/static addressing. The worker drives OpenTofu (bpg/proxmox) against
# the Proxmox API; the API needs only the network shape + budget below (never the credentials).
# Like vSphere it CANNOT be combined with KAAS_KVM_HOST, and the worker must route to the subnet.
#
# KAAS_PROXMOX_ENDPOINT=https://172.23.234.12:8006/
# KAAS_PROXMOX_INSECURE=1                     # accept a self-signed Proxmox certificate (lab)
#
# Authentication - set EITHER a token OR a username/password, not both:
# KAAS_PROXMOX_API_TOKEN=kaas@pve!tofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# KAAS_PROXMOX_USERNAME=kaas@pve
# KAAS_PROXMOX_PASSWORD=...
#
# KAAS_PROXMOX_NODE=proxmox01                 # the node VMs are created on
# KAAS_PROXMOX_DATASTORE=Pool3ParNew          # datastore for VM disks + the cloud-init drive
# KAAS_PROXMOX_MODULE_DIR=infra/proxmox        # optional override
#
# Networking - one operator bridge shared by every Proxmox cluster. Modes mirror vSphere:
#   dhcp   - the site's DHCP assigns node IPs; read back via the QEMU guest agent (baked into the
#            golden image). For an HA cluster the USER supplies the control-plane VIP.
#   static - the platform allocates node IPs and the HA VIP from KAAS_PROXMOX_NET_RANGE and injects
#            them via native cloud-init ip_config.
# KAAS_PROXMOX_NET_BRIDGE=vmbr0
# KAAS_PROXMOX_NET_VLAN=199                   # VLAN tag on a VLAN-aware bridge (omit/0 = untagged)
# KAAS_PROXMOX_NET_MODE=dhcp                  # dhcp | static
# KAAS_PROXMOX_NET_CIDR=172.23.234.0/24        # the bridge's subnet
# KAAS_PROXMOX_NET_GATEWAY=172.23.234.254
# KAAS_PROXMOX_NET_DNS=172.23.234.10
# KAAS_PROXMOX_NET_RANGE=172.23.234.50-172.23.234.70   # inclusive; must be free and outside DHCP
#
# Golden-image build only: on a STATIC-only node network (no DHCP), the Packer build VM needs a free
# address to be reachable. Set it to a free <ip>/<prefix> on the node network (gateway + DNS come
# from KAAS_PROXMOX_NET_GATEWAY / _NET_DNS). Leave unset on a DHCP network.
# KAAS_PROXMOX_BUILD_IP=172.23.252.240/24
#
# The Proxmox capacity ceiling - its own conserved pool, not interchangeable with a KVM/vSphere grant.
# KAAS_PROXMOX_BUDGET_VCPU=64
# KAAS_PROXMOX_BUDGET_MEM_MB=131072
# KAAS_PROXMOX_BUDGET_DISK_GB=4096

# --- NetBox IPAM (optional; shared-network clusters - vSphere and Proxmox) --
#
# Opt-in: setting KAAS_NETBOX_URL makes the platform RECORD every address its vSphere and Proxmox
# clusters occupy (node IPs + the HA VIP) in NetBox, and release them on cluster deletion. It
# records, it does not allocate - the addresses are still decided by the DHCP server or by the
# platform's own allocator. KVM clusters are never registered: their networks are private,
# per-cluster, and of no interest to a site IPAM.
#
# Records carry the tag below and a "kaas:<cluster-id>" description marker, so an existing
# vCenter→NetBox sync (with its own tags) coexists and we only ever delete what we created.
# Registration failures FAIL the reconcile step, which then retries - an IPAM that silently drifts
# from reality is worse than a slow one.
#
# KAAS_NETBOX_URL=https://netbox.example.internal
# KAAS_NETBOX_TOKEN=...                       # or provision one from a username/password:
# KAAS_NETBOX_USERNAME=user
# KAAS_NETBOX_PASSWORD=...
# KAAS_NETBOX_INSECURE=1                      # accept a self-signed NetBox certificate (lab)
# KAAS_NETBOX_TAG=kaas                        # the tag our records carry (default: kaas)

# --- Cluster DNS (optional) -------------------------------------------------
#
# Opt-in: setting KAAS_DNS_BASE_DOMAIN gives every cluster a subdomain of it
# ("<cluster>.kaas.example.internal") and publishes ONE platform-owned record per cluster,
#
#     *.apps.<cluster>.kaas.example.internal  A  <the cluster's Envoy Gateway address>
#
# once the default gateway is wired. Users then expose an app by attaching an HTTPRoute for any name
# under that wildcard to the cluster's default Gateway - no per-app DNS, no ingress to install. The
# record is WITHDRAWN before the cluster's infrastructure is destroyed, because its address is
# recycled to the next cluster on that subnet. The bundled external-dns add-on is pointed at the same
# server and confined to the cluster's own subdomain, for the extra names a user's
# Services/Ingresses/HTTPRoutes ask for.
#
# Point this at a zone DELEGATED to the platform, not at the AD domain itself: the service account
# below can write everything in it. KAAS_DNS and the credentials are the WORKER's alone - the API
# only names domains at admission (it gets the base domain + apps label, nothing more).
#
# KAAS_DNS_BASE_DOMAIN=kaas.example.internal
# KAAS_DNS_APPS_LABEL=apps                    # *.apps.<cluster>.<base domain> (default: apps)
# KAAS_DNS=nsupdate                           # fake (default) just logs what it would publish
# KAAS_DNS_SERVER=dc01.example.internal      # the DC's FQDN - GSS-TSIG authenticates to DNS/<fqdn>
# KAAS_DNS_ZONE=kaas.example.internal        # the delegated zone (default: the base domain)
# KAAS_DNS_TTL=300
# KAAS_DNS_AUTH=gss                           # gss (AD secure updates) | tsig | none
# KAAS_DNS_KRB_USERNAME=svc-kaas-dns          # or svc-kaas-dns@EXAMPLE.INTERNAL
# KAAS_DNS_KRB_PASSWORD=...
# KAAS_DNS_KRB_REALM=EXAMPLE.INTERNAL        # the AD realm, NOT the delegated zone
# KAAS_DNS_TSIG_KEYNAME=kaas-key              # KAAS_DNS_AUTH=tsig only
# KAAS_DNS_TSIG_SECRET=...                    # base64
# KAAS_DNS_TSIG_ALGO=hmac-sha256

# Windows DNS Server refuses to create a wildcard record ("*.foo A ...") over RFC 2136 dynamic
# update - confirmed against a real DC: NOTAUTH/REFUSED no matter the zone's dynamic-updates
# setting or KAAS_DNS_AUTH, while a plain (non-wildcard) name updates fine. Since the platform's
# wildcard is the only record nsupdate is ever asked to write, that path can never work against a
# Windows DC. KAAS_DNS=winrm is the fix: it drives the DNS Server role's own PowerShell module
# (Add-DnsServerResourceRecordA / Remove-DnsServerResourceRecord) over WinRM instead of RFC 2136.
# It reuses KAAS_DNS_SERVER/_ZONE/_TTL above (as the -ComputerName target and -ZoneName) - only the
# transport and credential below are new. external-dns is unaffected either way: it only ever
# creates concrete, non-wildcard hostnames, so it keeps using nsupdate/GSS-TSIG regardless.
# KAAS_DNS=winrm
# KAAS_WINRM_HOST=dc01.example.internal      # default: KAAS_DNS_SERVER
# KAAS_WINRM_PORT=5986                        # default: 5986 https / 5985 http
# KAAS_WINRM_INSECURE_HTTP=0                  # 1 = plain HTTP instead of HTTPS (lab shortcut)
# KAAS_WINRM_INSECURE=0                       # 1 = skip TLS verification (self-signed WinRM cert)
# KAAS_WINRM_USERNAME=svc-kaas-dns            # NTLM - production would use Kerberos, like nsupdate
# KAAS_WINRM_PASSWORD=...

# --- HashiCorp Vault (internal/vault) ---------------------------------------
#
# The platform's secret store, deployed alongside it (the `vault` compose service / the kaas Helm
# chart's vault dependency) and assumed ALWAYS present. The reconciler creates a `kaas` KV mount, a
# per-cluster path (kaas/clusters/<id>/<namespace>/<name>) created and deleted with the cluster, and
# the policies + identity groups that MIRROR the portal's per-cluster read/write access - so only a
# user with access to a cluster can touch its Vault path, writers can edit, readers can only view.
# The bundled external-secrets add-on syncs those secrets into Kubernetes Secrets.
#
# KAAS_VAULT defaults to `real` (up-fake talks to the bundled dev Vault, a fully working demo). Set
# `fake` to opt out (in-memory seam, no Vault). The auth backend Vault is configured with follows
# KAAS_AUTH (local → userpass, ldap → the same directory). Dev Vault is auto-unsealed with a fixed
# root token - a DELIBERATE demo shortcut; production would run HA Vault with auto-unseal (a KMS),
# persistent storage and an audit device, and a token scoped to the mount rather than root.
# KAAS_VAULT=real                             # real | fake
# KAAS_VAULT_ADDR=http://vault:8200           # compose api; the worker uses host.containers.internal
# KAAS_VAULT_TOKEN=kaas-root-dev              # management token (worker) / minter (api); dev root here
# KAAS_VAULT_MOUNT=kaas
# KAAS_VAULT_UI_URL=http://localhost:8200     # browser-facing, for the "View in Vault" deep-link
# KAAS_VAULT_INSECURE=0                        # 1 = skip TLS verification (a self-signed Vault)

# --- Real Ansible config manager (KAAS_CONFIG=ansible) ----------------------

# Private key matching KAAS_SSH_PUBLIC_KEY; Ansible uses it to reach the nodes.
# KAAS_SSH_PRIVATE_KEY_FILE=/home/you/.ssh/kaas

# Optional overrides (defaults shown):
# KAAS_ANSIBLE_BIN=ansible-playbook
# KAAS_ANSIBLE_DIR=ansible
# KAAS_SSH_USER=kaas

# --- In-browser cluster shell (internal/shell) ------------------------------
# The portal's Terminal tab. fake = an in-process simulated kubectl (default; make up-fake).
# worker = a real bash+kubectl PTY the API proxies to. In containerized real mode (`make up`) that
# PTY runs in the dedicated, unprivileged `shell` sandbox - a host-networked container stripped of
# every secret/key/socket (deploy/Containerfile.shell + the shell service), so a user's terminal
# never lands on the worker. `make up` sets these for you.
#
# On the API:    KAAS_SHELL=worker and where to reach the exec agent (the sandbox). The address
# accepts a COMMA-SEPARATED LIST - the agents hold no state between requests, so the API spreads
# sessions and kubectl calls over them and fails over when one is unreachable. That is how the agent
# tier scales out (`make up-scale` runs two; see docs/running.md#scaling-out).
# KAAS_SHELL=fake
# KAAS_SHELL_AGENT_ADDR=host.containers.internal:8082
# KAAS_SHELL_AGENT_ADDR=host.containers.internal:8082,host.containers.internal:8083
#
# On the sandbox: bind address + shell binary (the shell service sets these).
# KAAS_SHELL_LISTEN=:8082
# KAAS_SHELL_BIN=bash
#
# Shared bearer token the API presents to the exec agent. SET THIS for real use: the sandbox holds
# no KAAS_SECRET_KEY to derive one from, so both the API and the sandbox must read the same literal
# value here. If left empty the exec channel runs UNAUTHENTICATED (localhost-only, and warned).
# (For the single-process dev path `make run-worker`, the worker itself hosts the agent and - like
# the API - falls back to deriving the token from KAAS_SECRET_KEY when this is unset.)
# KAAS_SHELL_TOKEN=change-me-to-a-long-random-string

# --- Node SSH (internal/nodessh) ---------------------------------------------
# The Nodes tab → SSH button: an in-browser `ssh` session (as the kaas user) INTO a cluster VM, for
# OS-level inspection the kubectl shell can't do. Write-scoped. It runs in its OWN sandbox - separate
# from the shell one - because it must hold the platform's VM SSH key, and the key-holding container
# must be structurally incapable of serving a bash PTY (it starts only ssh). `make up` sets these.
#
# On the API:    KAAS_NODE_SSH=agent + the sandbox address (its own comma-separated pool + port).
# KAAS_NODE_SSH=fake
# KAAS_NODE_SSH_AGENT_ADDR=host.containers.internal:8084
# KAAS_NODE_SSH_AGENT_ADDR=host.containers.internal:8084,host.containers.internal:8085
#
# On the sandbox: bind address (the nodessh service sets it). It reads the VM key from
# KAAS_SSH_PRIVATE_KEY_FILE and the login from KAAS_SSH_USER (default kaas) - the SAME pair the worker
# uses for Ansible - plus, for a remote KVM host, the bastion KAAS_KVM_* vars.
# KAAS_NODE_SSH_LISTEN=:8084
#
# Shared bearer token - DISTINCT from KAAS_SHELL_TOKEN so a leaked shell token can't open this
# key-holding sandbox. Same rules: set it for real use, else the channel is unauthenticated (warned).
# KAAS_NODE_SSH_TOKEN=change-me-to-a-different-long-random-string

# --- Workloads & Monitoring pages (internal/kube, internal/monitoring) -------
# The other two request-driven cluster query seams. Both fake by default (synthesized data; make
# up-fake), or `worker` to forward each kubectl / PromQL query to the same host-networked worker
# exec agent as the shell (reusing KAAS_SHELL_AGENT_ADDR + the shared token). `make up` sets these.
# KAAS_KUBE=fake         # Workloads page: worker-proxied `kubectl ... -o json`
# KAAS_MONITORING=fake   # Monitoring page: worker-proxied Prometheus queries (kubectl get --raw)
# KAAS_TUNNEL=fake       # Monitoring "Open UI" links: worker-proxied HTTP to Grafana/Prometheus/Alertmanager

# --- Persistence ------------------------------------------------------------
# Unset = in-memory store (default; tests + quick runs need no DB). Set it to use the
# real Postgres store (durable state; survives restart). Migrations run on startup from
# KAAS_MIGRATIONS_DIR (default "migrations").
# DATABASE_URL=postgres://kaas:kaas@localhost:5432/kaas?sslmode=disable
# KAAS_MIGRATIONS_DIR=migrations
