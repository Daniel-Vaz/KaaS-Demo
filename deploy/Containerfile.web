# Build the web portal (React + Mantine SPA) and serve it from nginx. nginx also reverse-proxies
# /api/* to the Go control-plane API (see deploy/nginx.conf), so the browser talks to a single
# same-origin front door on :8080. Build context is the repo root (like the api/worker images);
# .containerignore keeps web/portal/node_modules and dist out of the context.
FROM docker.io/library/node:26-alpine AS build
WORKDIR /app
COPY web/portal/package.json web/portal/package-lock.json ./
# --legacy-peer-deps: @xterm/addon-fit's stable line only declares a peer on @xterm/xterm ^5.0.0
# (the ^6.0.0-compatible release is still a beta); verified in-browser that xterm 6 + addon-fit
# 0.10.0 render, accept input and resize correctly despite the unmet peer.
RUN npm ci --no-audit --no-fund --legacy-peer-deps
COPY web/portal/ ./
RUN npm run build

FROM docker.io/library/nginx:alpine
# Build identity. Unlike the Go images this is labels only - the portal reads its version from the
# API at runtime (GET /api/version) rather than baking one in, so the page always names the platform
# it is actually talking to. See internal/version and docs/deploy/releasing.md.
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
LABEL org.opencontainers.image.title="kaas-web" \
      org.opencontainers.image.description="KubeHarbor portal (React SPA) served by nginx, proxying /api" \
      org.opencontainers.image.source="https://github.com/Daniel-Vaz/KaaS-Demo" \
      org.opencontainers.image.documentation="https://github.com/Daniel-Vaz/KaaS-Demo/blob/main/docs/README.md" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${DATE}" \
      org.opencontainers.image.vendor="KubeHarbor"
# The upgrade map must load at http-level (a sibling of default.conf under conf.d), so WebSocket
# upgrades work for the cluster shell without breaking SSE. See deploy/nginx-upgrade-map.conf.
COPY deploy/nginx-upgrade-map.conf /etc/nginx/conf.d/00-upgrade-map.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# Fills in the `resolver` directive from the container's DNS at start-up, so nginx re-resolves the
# `api` upstream and picks up api replicas as they come and go (see deploy/nginx-resolver.sh). The
# nginx image runs everything in /docker-entrypoint.d before starting.
COPY deploy/nginx-resolver.sh /docker-entrypoint.d/20-kaas-resolver.sh
RUN chmod +x /docker-entrypoint.d/20-kaas-resolver.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
